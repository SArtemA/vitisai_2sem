<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_VitiPredict_Retrain" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:collaboration id="Collaboration_VitiPredict">
    <bpmn:participant id="Participant_MLOps" name="VitiPredict ML: Пайплайн автопереобучения и смены моделей" processRef="Process_Retraining_Cycle" />
    <bpmn:textAnnotation id="TextAnnotation_1vgqeq2">
      <bpmn:text>Агроном или ML-инженер</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1ujfo8w" associationDirection="None" sourceRef="Task_HITL_Review" targetRef="TextAnnotation_1vgqeq2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Retraining_Cycle" isExecutable="true">
    <bpmn:laneSet id="LaneSet_MLOps">
      <bpmn:lane id="Lane_Automated" name="MLOps &#38; Backend (Автоматический контур)">
        <bpmn:flowNodeRef>Start_DriftTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_VolumeTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_ManualTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Triggers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Preprocess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainModels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateMetrics</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Val_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompareModels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Model_Compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeployModel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyKeepOld</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifySuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Deployed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_KeepOld</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Expert" name="Эксперт / ML-инженер (Human-in-the-Loop)">
        <bpmn:flowNodeRef>Task_HITL_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HITL_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_DriftTrigger" name="Детекция дрифта GEE (PSI &#62; 0.25)">
      <bpmn:outgoing>Flow_T2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_T1" sourceRef="Start_VolumeTrigger" targetRef="Gateway_Triggers" />
    <bpmn:sequenceFlow id="Flow_T2" sourceRef="Start_DriftTrigger" targetRef="Gateway_Triggers" />
    <bpmn:sequenceFlow id="Flow_T3" sourceRef="Start_ManualTrigger" targetRef="Gateway_Triggers" />
    <bpmn:sequenceFlow id="Flow_To_Collect" sourceRef="Gateway_Triggers" targetRef="Task_CollectData" />
    <bpmn:sequenceFlow id="Flow_To_Val" sourceRef="Task_TrainModels" targetRef="Task_ValidateMetrics" />
    <bpmn:sequenceFlow id="Flow_To_ValGate" sourceRef="Task_ValidateMetrics" targetRef="Gateway_Val_Check" />
    <bpmn:sequenceFlow id="Flow_Val_Pass" name="Да (F1 &#62;= 0.85)" sourceRef="Gateway_Val_Check" targetRef="Task_CompareModels" />
    <bpmn:sequenceFlow id="Flow_Val_HITL" name="Пограничный F1 / Дрифт" sourceRef="Gateway_Val_Check" targetRef="Task_HITL_Review" />
    <bpmn:sequenceFlow id="Flow_To_HITL_Decision" sourceRef="Task_HITL_Review" targetRef="Gateway_HITL_Decision" />
    <bpmn:sequenceFlow id="Flow_HITL_Approve" name="Одобрено" sourceRef="Gateway_HITL_Decision" targetRef="Task_CompareModels" />
    <bpmn:sequenceFlow id="Flow_HITL_Reject" name="Отклонено" sourceRef="Gateway_HITL_Decision" targetRef="Task_NotifyReject" />
    <bpmn:sequenceFlow id="Flow_To_EndReject" sourceRef="Task_NotifyReject" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_To_CompareGate" sourceRef="Task_CompareModels" targetRef="Gateway_Model_Compare" />
    <bpmn:sequenceFlow id="Flow_Model_Better" name="Да (ΔF1 &#62;= ε)" sourceRef="Gateway_Model_Compare" targetRef="Task_DeployModel" />
    <bpmn:sequenceFlow id="Flow_Model_NotBetter" name="Нет (без улучшений)" sourceRef="Gateway_Model_Compare" targetRef="Task_NotifyKeepOld" />
    <bpmn:sequenceFlow id="Flow_To_NotifySuccess" sourceRef="Task_DeployModel" targetRef="Task_NotifySuccess" />
    <bpmn:sequenceFlow id="Flow_To_EndDeployed" sourceRef="Task_NotifySuccess" targetRef="End_Deployed" />
    <bpmn:sequenceFlow id="Flow_To_EndKeepOld" sourceRef="Task_NotifyKeepOld" targetRef="End_KeepOld" />
    <bpmn:startEvent id="Start_VolumeTrigger" name="Порог: +1000 записей в SQLite">
      <bpmn:outgoing>Flow_T1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_ManualTrigger" name="Ручной запуск">
      <bpmn:outgoing>Flow_T3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_Triggers" name="Слияние триггеров">
      <bpmn:incoming>Flow_T1</bpmn:incoming>
      <bpmn:incoming>Flow_T2</bpmn:incoming>
      <bpmn:incoming>Flow_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Collect</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CollectData" name="Сбор данных и валидация статусов GEE">
      <bpmn:incoming>Flow_To_Collect</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Preprocess</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Preprocess" name="Предобработка: фильтрация нулей, scaler">
      <bpmn:incoming>Flow_To_Preprocess</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Train</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_TrainModels" name="Обучение моделей XGBoost (BinSuit + MultiGrape)">
      <bpmn:incoming>Flow_To_Train</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Val</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_To_Preprocess" sourceRef="Task_CollectData" targetRef="Task_Preprocess" />
    <bpmn:sequenceFlow id="Flow_To_Train" sourceRef="Task_Preprocess" targetRef="Task_TrainModels" />
    <bpmn:serviceTask id="Task_ValidateMetrics" name="Валидация: расчет F1, ROC-AUC">
      <bpmn:incoming>Flow_To_Val</bpmn:incoming>
      <bpmn:outgoing>Flow_To_ValGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Val_Check" name="F1 &#62;= 0.85 и нет деградации?">
      <bpmn:incoming>Flow_To_ValGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Val_Pass</bpmn:outgoing>
      <bpmn:outgoing>Flow_Val_HITL</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_HITL_Review" name="HITL: Экспертная валидация метрик">
      <bpmn:incoming>Flow_Val_HITL</bpmn:incoming>
      <bpmn:outgoing>Flow_To_HITL_Decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CompareModels" name="Сравнение моделей:&#10; New vs Old+δ">
      <bpmn:incoming>Flow_Val_Pass</bpmn:incoming>
      <bpmn:incoming>Flow_HITL_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_To_CompareGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_HITL_Decision" name="Решение эксперта?">
      <bpmn:incoming>Flow_To_HITL_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_HITL_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_HITL_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_NotifyReject" name="Notify: переобучение отклонено экспертом">
      <bpmn:incoming>Flow_HITL_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_To_EndReject</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Rejected" name="Пайплайн остановлен">
      <bpmn:incoming>Flow_To_EndReject</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Model_Compare" name="Новая модельF1 ≥ Текущая модель F1 + δ?">
      <bpmn:incoming>Flow_To_CompareGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Model_Better</bpmn:outgoing>
      <bpmn:outgoing>Flow_Model_NotBetter</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_DeployModel" name="6. Автодеплой: атомарная замена модел и reload в FastAPI">
      <bpmn:incoming>Flow_Model_Better</bpmn:incoming>
      <bpmn:outgoing>Flow_To_NotifySuccess</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_NotifyKeepOld" name="Notify: сохранена текущая модель">
      <bpmn:incoming>Flow_Model_NotBetter</bpmn:incoming>
      <bpmn:outgoing>Flow_To_EndKeepOld</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_NotifySuccess" name="Notify:&#10;Отчет и метрики">
      <bpmn:incoming>Flow_To_NotifySuccess</bpmn:incoming>
      <bpmn:outgoing>Flow_To_EndDeployed</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Deployed" name="Новая модель активна в проде">
      <bpmn:incoming>Flow_To_EndDeployed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_KeepOld" name="Сохранена текущая версия">
      <bpmn:incoming>Flow_To_EndKeepOld</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_VitiPredict">
